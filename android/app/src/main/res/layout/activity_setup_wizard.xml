<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">
    
    <!-- Conteúdo principal do wizard -->
    <ScrollView
        android:id="@+id/wizardContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">
            
            <!-- Barra de progresso no topo -->
            <ProgressBar
                android:id="@+id/setupProgress"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginBottom="8dp"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:max="100"
                android:progress="0"
                android:progressTint="#4CAF50" />
            
            <TextView
                android:id="@+id/setupProgressText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="0 de 5"
                android:textSize="12sp"
                android:textColor="#666666"
                android:layout_marginBottom="32dp" />
            
            <!-- Ícone da etapa -->
            <ImageView
                android:id="@+id/setupIcon"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_lock_idle_lock"
                android:layout_marginBottom="24dp"
                android:tint="#4CAF50" />
            
            <!-- Título da etapa -->
            <TextView
                android:id="@+id/setupTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bem-vindo"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:gravity="center"
                android:layout_marginBottom="16dp" />
            
            <!-- Descrição da etapa -->
            <TextView
                android:id="@+id/setupDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Descrição da etapa"
                android:textSize="16sp"
                android:textColor="#666666"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="32dp" />
            
            <!-- Espaço para empurrar botão para baixo -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />
            
            <!-- Botão Avançar -->
            <Button
                android:id="@+id/btnNext"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Avançar"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:background="@drawable/btn_rounded_green"
                android:elevation="4dp" />
            
        </LinearLayout>
    </ScrollView>
    
    <!-- View de Loading (oculta por padrão) -->
    <LinearLayout
        android:id="@+id/loadingView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="#F5F5F5"
        android:visibility="gone">
        
        <ProgressBar
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:indeterminateTint="#4CAF50" />
        
        <TextView
            android:id="@+id/loadingMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Configurando..."
            android:textSize="16sp"
            android:textColor="#666666"
            android:layout_marginTop="16dp" />
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Por favor, aguarde"
            android:textSize="14sp"
            android:textColor="#999999"
            android:layout_marginTop="8dp" />
    </LinearLayout>
    
</FrameLayout>
